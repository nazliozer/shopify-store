<section class="related-blogs page-width">
  {%- comment -%} Get related blogs from collection or homepage settings {%- endcomment -%}
  {%- assign related_blogs = nil -%}
  
  {%- if template.name == 'collection' and collection.metafields.custom.related_blogs != blank -%}
    {%- assign related_blogs = collection.metafields.custom.related_blogs.value -%}
  {%- elsif template.name == 'index' and section.settings.homepage_blogs != blank -%}
    {%- assign related_blogs = section.settings.homepage_blogs.value -%}
  {%- elsif template.name == 'index' and section.settings.homepage_blogs_list != blank -%}
    {%- assign related_blogs = section.settings.homepage_blogs_list.value -%}
  {%- endif -%}

  {%- comment -%} Debug: Show what we have {%- endcomment -%}
  {%- if request.design_mode -%}
    <div style="background: #f0f0f0; padding: 1rem; margin: 1rem 0; border-radius: 8px; font-size: 0.9rem;">
      <strong>Debug Info:</strong><br>
      Template: {{ template.name }}<br>
      Collection blogs: {{ collection.metafields.custom.related_blogs | json }}<br>
      Homepage blogs: {{ section.settings.homepage_blogs | json }}<br>
      Related blogs: {{ related_blogs | json }}<br><br>
      
      <strong>Metaobject Details:</strong><br>
      {%- if section.settings.homepage_blogs != blank -%}
        Homepage blogs metaobject: {{ section.settings.homepage_blogs | json }}<br>
        Homepage blogs type: {{ section.settings.homepage_blogs.object_type }}<br>
        Homepage blogs fields: {{ section.settings.homepage_blogs.fields | json }}<br>
        {%- for field in section.settings.homepage_blogs.fields -%}
          Field: {{ field.key }} = {{ field.value | json }}<br>
        {%- endfor -%}
      {%- else -%}
        Homepage blogs is blank<br>
      {%- endif -%}
      
      {%- if section.settings.homepage_blogs_list != blank -%}
        Homepage blogs list: {{ section.settings.homepage_blogs_list | json }}<br>
        Homepage blogs list type: {{ section.settings.homepage_blogs_list.object_type }}<br>
        Homepage blogs list count: {{ section.settings.homepage_blogs_list.value.size }}<br>
      {%- else -%}
        Homepage blogs list is blank<br>
      {%- endif -%}
      
      {%- if collection.metafields.custom.related_blogs != blank -%}
        Collection blogs metaobject: {{ collection.metafields.custom.related_blogs | json }}<br>
        Collection blogs type: {{ collection.metafields.custom.related_blogs.object_type }}<br>
        Collection blogs fields: {{ collection.metafields.custom.related_blogs.fields | json }}<br>
        {%- for field in collection.metafields.custom.related_blogs.fields -%}
          Field: {{ field.key }} = {{ field.value | json }}<br>
        {%- endfor -%}
      {%- else -%}
        Collection blogs is blank<br>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if related_blogs != blank -%}
    <h2 class="related-blogs__title">{{ section.settings.heading | default: 'Related Articles' }}</h2>
    <div class="related-blogs__grid">
      {%- for blog_post in related_blogs -%}
        <article class="related-blogs__card">
          {%- comment -%} Handle different metaobject structures {%- endcomment -%}
          {%- assign post_image = blog_post.image | default: blog_post.featured_image | default: blog_post.thumbnail -%}
          {%- assign post_title = blog_post.title | default: blog_post.heading | default: blog_post.name -%}
          {%- assign post_excerpt = blog_post.excerpt | default: blog_post.description | default: blog_post.summary -%}
          {%- assign post_url = blog_post.article.url | default: blog_post.url | default: blog_post.link -%}
          
          {%- if post_image != blank -%}
            <a href="{{ post_url }}" class="related-blogs__image-link">
              <img 
                src="{{ post_image | image_url: width: 600 }}" 
                alt="{{ post_title | escape }}" 
                class="related-blogs__image" 
                loading="lazy"
              >
            </a>
          {%- endif -%}

          <div class="related-blogs__content">
            <h3 class="related-blogs__heading">
              <a href="{{ post_url }}">{{ post_title }}</a>
            </h3>
            {%- if post_excerpt != blank -%}
              <p class="related-blogs__excerpt">{{ post_excerpt }}</p>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  {%- else -%}
    <div class="related-blogs__empty">
      {%- if template.name == 'collection' -%}
        <p>No related blog posts found for this collection.</p>
      {%- else -%}
        <p>No featured blog posts found.</p>
      {%- endif -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Related Blog Posts",
  "tag": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Section Heading",
      "default": "Related Articles"
    },
    {
      "type": "metaobject",
      "id": "homepage_blogs",
      "label": "Homepage Blog Posts",
      "metaobject_type": "blog_post",
      "info": "Select blog posts to display on the homepage"
    },
    {
      "type": "metaobject_list",
      "id": "homepage_blogs_list",
      "label": "Homepage Blog Posts (List)",
      "metaobject_type": "blog_post",
      "info": "Select multiple blog posts to display on the homepage"
    }
  ],
  "presets": [
    {
      "name": "Related Blog Posts"
    }
  ],
  "enabled_on": {
    "templates": ["collection", "index"]
  }
}
{% endschema %}

<style>
.related-blogs {
  margin: 4rem 0;
  padding: 0;
}

.related-blogs__title {
  font-size: 2.5rem;
  font-weight: 600;
  margin-bottom: 2.5rem;
  text-align: center;
  color: #2d3748;
  position: relative;
  letter-spacing: -0.02em;
}

.related-blogs__title::after {
  content: '';
  position: absolute;
  bottom: -12px;
  left: 50%;
  transform: translateX(-50%);
  width: 80px;
  height: 2px;
  background: linear-gradient(90deg, #a0aec0, #cbd5e0);
  border-radius: 1px;
}

.related-blogs__grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 2.5rem;
  max-width: 1200px;
  margin: 0 auto;
}

.related-blogs__card {
  background: #ffffff;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.08), 0 2px 4px -1px rgba(0, 0, 0, 0.04);
  transition: all 0.3s ease;
  border: 1px solid #f0f0f0;
}

.related-blogs__card:hover {
  transform: translateY(-4px);
  box-shadow: 0 10px 25px -3px rgba(0, 0, 0, 0.12), 0 4px 6px -2px rgba(0, 0, 0, 0.08);
  border-color: #e0e0e0;
}

.related-blogs__image-link {
  display: block;
  overflow: hidden;
}

.related-blogs__image {
  width: 100%;
  height: 220px;
  object-fit: cover;
  transition: transform 0.3s ease;
}

.related-blogs__card:hover .related-blogs__image {
  transform: scale(1.05);
}

.related-blogs__content {
  padding: 1.5rem;
}

.related-blogs__heading {
  font-size: 1.25rem;
  font-weight: 600;
  margin: 0 0 1rem 0;
  line-height: 1.4;
  color: #2d3748;
}

.related-blogs__heading a {
  text-decoration: none;
  color: inherit;
  transition: color 0.2s ease;
}

.related-blogs__heading a:hover {
  color: #4a5568;
}

.related-blogs__excerpt {
  font-size: 1rem;
  color: #4a5568;
  line-height: 1.6;
  margin: 0;
  font-weight: 400;
}

.related-blogs__empty {
  text-align: center;
  color: #718096;
  font-size: 1.125rem;
  padding: 3rem 2rem;
  background: #f8f8f8;
  border-radius: 16px;
  border: 1px solid #f0f0f0;
}

/* Responsive Design */
@media (max-width: 768px) {
  .related-blogs {
    margin: 2rem 0;
  }
  
  .related-blogs__title {
    font-size: 2rem;
    margin-bottom: 2rem;
  }
  
  .related-blogs__grid {
    grid-template-columns: 1fr;
    gap: 2rem;
    padding: 0 1rem;
  }
  
  .related-blogs__card {
    border-radius: 12px;
  }
  
  .related-blogs__content {
    padding: 1.25rem;
  }
  
  .related-blogs__image {
    height: 200px;
  }
}
</style>
