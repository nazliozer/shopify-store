<section class="related-blogs page-width">
  {%- if template.name == 'collection' and collection.metafields.custom.related_blogposts != blank -%}
    {%- assign related_blogs = collection.metafields.custom.related_blogposts.value -%}

    <h2 class="related-blogs__title">
      {{ section.settings.heading | default: 'Related Articles' }}
    </h2>

    <div class="related-blogs__grid">
      {%- for blog_post in related_blogs -%}
        <article class="related-blogs__card">
          {%- if blog_post.image != blank -%}
            <a href="{{ blog_post.url }}" class="related-blogs__image-link">
              <img 
                src="{{ blog_post.image | image_url: width: 600 }}" 
                alt="{{ blog_post.title | escape }}" 
                class="related-blogs__image" 
                loading="lazy"
              >
            </a>
          {%- endif -%}

          <div class="related-blogs__content">
            <h3 class="related-blogs__heading">
              <a href="{{ blog_post.url }}">{{ blog_post.title }}</a>
            </h3>
            {%- if blog_post.excerpt != blank -%}
              <p class="related-blogs__excerpt">{{ blog_post.excerpt }}</p>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  {%- else -%}
    <div class="related-blogs__empty">
      <p>No related blog posts found for this collection.</p>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Related Blog Posts",
  "tag": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Section Heading",
      "default": "Related Articles"
    }
  ],
  "presets": [
    {
      "name": "Related Blog Posts"
    }
  ],
  "enabled_on": {
    "templates": ["collection"]
  }
}
{% endschema %}

<style>
.related-blogs {
  margin: 4rem 0;
}

.related-blogs__title {
  font-size: 2rem;
  text-align: center;
  margin-bottom: 2rem;
}

.related-blogs__grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 2rem;
}

.related-blogs__card {
  background: #fff;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 2px 6px rgba(0,0,0,0.1);
  transition: transform 0.2s ease;
}

.related-blogs__card:hover {
  transform: translateY(-4px);
}

.related-blogs__image {
  width: 100%;
  height: 200px;
  object-fit: cover;
}

.related-blogs__content {
  padding: 1rem 1.25rem;
}

.related-blogs__heading {
  font-size: 1.25rem;
  margin: 0 0 0.5rem;
}

.related-blogs__excerpt {
  font-size: 0.95rem;
  color: #555;
}
</style>
