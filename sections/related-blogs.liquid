<section class="related-blogs page-width">
  {%- if template.name == 'collection' and collection.metafields.custom.related_blogposts != blank -%}
    {%- assign related_blogs = collection.metafields.custom.related_blogposts.value -%}

    <h2 class="related-blogs__title">
      {{ section.settings.heading | default: 'Related Articles' }}
    </h2>

    <div class="related-blogs__grid">
      {%- for blog_post in related_blogs -%}
        <article class="related-blogs__card">
          {%- if blog_post.image != blank -%}
            <a href="{{ blog_post.url }}" class="related-blogs__image-link">
              <img 
                src="{{ blog_post.image | image_url: width: 600 }}" 
                alt="{{ blog_post.title | escape }}" 
                class="related-blogs__image" 
                loading="lazy"
              >
            </a>
          {%- endif -%}

          <div class="related-blogs__content">
            <h3 class="related-blogs__heading">
              <a href="{{ blog_post.url }}">{{ blog_post.title }}</a>
            </h3>
            {%- if blog_post.excerpt != blank -%}
              <p class="related-blogs__excerpt">{{ blog_post.excerpt }}</p>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  {%- else -%}
    <div class="related-blogs__empty">
      <p>No related blog posts found for this collection.</p>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Related Blog Posts",
  "tag": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Section Heading",
      "default": "Related Articles"
    }
  ],
  "presets": [
    {
      "name": "Related Blog Posts"
    }
  ],
  "enabled_on": {
    "templates": ["collection"]
  }
}
{% endschema %}

<style>
.related-blogs {
  margin: 4rem 0;
  padding: 0 2rem;
}

.related-blogs__title {
  font-size: 2.5rem;
  font-weight: 600;
  text-align: center;
  margin-bottom: 2.5rem;
  color: #2d3748;
  position: relative;
  letter-spacing: -0.02em;
}

.related-blogs__title::after {
  content: '';
  position: absolute;
  bottom: -12px;
  left: 50%;
  transform: translateX(-50%);
  width: 80px;
  height: 2px;
  background: linear-gradient(90deg, #a0aec0, #cbd5e0);
  border-radius: 1px;
}

.related-blogs__grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 2.5rem;
  max-width: 1200px;
  margin: 0 auto;
}

/* Single post styling - don't stretch */
.related-blogs__grid:has(.related-blogs__card:only-child) {
  grid-template-columns: minmax(320px, 400px);
  justify-content: center;
}

.related-blogs__card {
  background: #ffffff;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.08), 0 2px 4px -1px rgba(0, 0, 0, 0.04);
  transition: all 0.3s ease;
  border: 1px solid #f0f0f0;
  height: fit-content;
}

.related-blogs__card:hover {
  transform: translateY(-4px);
  box-shadow: 0 10px 25px -3px rgba(0, 0, 0, 0.12), 0 4px 6px -2px rgba(0, 0, 0, 0.08);
  border-color: #e0e0e0;
}

.related-blogs__image-link {
  display: block;
  overflow: hidden;
}

.related-blogs__image {
  width: 100%;
  height: 220px;
  object-fit: cover;
  transition: transform 0.3s ease;
}

.related-blogs__card:hover .related-blogs__image {
  transform: scale(1.05);
}

.related-blogs__content {
  padding: 1.5rem;
}

.related-blogs__heading {
  font-size: 1.25rem;
  font-weight: 600;
  margin: 0 0 1rem 0;
  line-height: 1.4;
  color: #2d3748;
}

.related-blogs__heading a {
  text-decoration: none;
  color: inherit;
  transition: color 0.2s ease;
  display: block;
}

.related-blogs__heading a:hover {
  color: #4a5568;
}

.related-blogs__excerpt {
  font-size: 1rem;
  color: #4a5568;
  line-height: 1.6;
  margin: 0;
  font-weight: 400;
}

.related-blogs__empty {
  text-align: center;
  color: #718096;
  font-size: 1.125rem;
  padding: 3rem 2rem;
  background: #f8f8f8;
  border-radius: 16px;
  border: 1px solid #f0f0f0;
}

/* Responsive Design */
@media (max-width: 768px) {
  .related-blogs {
    margin: 2rem 0;
    padding: 0 1rem;
  }
  
  .related-blogs__title {
    font-size: 2rem;
    margin-bottom: 2rem;
  }
  
  .related-blogs__grid {
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  
  /* Single post on mobile */
  .related-blogs__grid:has(.related-blogs__card:only-child) {
    grid-template-columns: 1fr;
    max-width: 400px;
  }
  
  .related-blogs__card {
    border-radius: 12px;
  }
  
  .related-blogs__content {
    padding: 1.25rem;
  }
  
  .related-blogs__image {
    height: 200px;
  }
}

/* Fallback for browsers that don't support :has() */
@supports not (selector(:has(*))) {
  .related-blogs__grid {
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  }
}
</style>
