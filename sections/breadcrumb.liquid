{% comment %}
  Breadcrumb Section
  - Works on collection, product, blog, article, and page templates.
  - Configurable via Theme Editor.
{% endcomment %}

<section class="breadcrumb page-width">
  <nav aria-label="Breadcrumb">
    <ol class="breadcrumb-list">
      <li>
        <a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a>
      </li>

      {%- if template.name == 'collection' and collection -%}
        <li>
          <span aria-current="page">{{ collection.title }}</span>
        </li>
      {%- elsif template.name == 'product' and product -%}
        {%- comment -%} Get collection from URL path {%- endcomment -%}
        {%- assign current_collection = nil -%}
        
        {%- if request.path contains '/collections/' -%}
          {%- comment -%} Collection URL'den geliyor {%- endcomment -%}
          {%- assign path_parts = request.path | split: '/collections/' | last | split: '/' | first -%}
          {%- assign current_collection = collections[path_parts] -%}
        {%- else -%}
          {%- comment -%} Anasayfadan veya direkt product URL'den geliyor - ana collection'ı göster {%- endcomment -%}
          {%- assign current_collection = product.collections.first -%}
        {%- endif -%}
        
        {%- if current_collection -%}
          <li>
            <a href="{{ current_collection.url }}">{{ current_collection.title }}</a>
          </li>
        {%- endif -%}
        <li>
          <span aria-current="page">{{ product.title }}</span>
        </li>
      {%- elsif template.name == 'blog' and blog -%}
        <li>
          <span aria-current="page">{{ blog.title }}</span>
        </li>
      {%- elsif template.name == 'article' and article -%}
        <li>
          <a href="{{ blog.url }}">{{ blog.title }}</a>
        </li>
        <li>
          <span aria-current="page">{{ article.title }}</span>
        </li>
      {%- elsif template.name == 'page' and page -%}
        <li>
          <span aria-current="page">{{ page.title }}</span>
        </li>
      {%- endif -%}
    </ol>
  </nav>
</section>

<style>
.breadcrumb {
  margin: 1rem 0 2rem;
  font-size: 0.95rem;
}
.breadcrumb-list {
  display: flex;
  flex-wrap: wrap;
  list-style: none;
  padding: 0;
  margin: 0;
}
.breadcrumb-list li {
  display: flex;
  align-items: center;
  color: #4a5568;
}
.breadcrumb-list li:not(:last-child)::after {
  content: "›";
  margin: 0 0.5rem;
  color: #a0aec0;
}
.breadcrumb-list a {
  color: #2d3748;
  text-decoration: none;
}
.breadcrumb-list a:hover {
  text-decoration: underline;
}
.breadcrumb-list span[aria-current="page"] {
  font-weight: 600;
  color: #1a202c;
}
</style>

{% schema %}
{
  "name": "Breadcrumb",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Show breadcrumb",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Breadcrumb"
    }
  ],
  "enabled_on": {
    "templates": ["collection", "product", "blog", "article", "page"]
  }
}
{% endschema %}
