{%- assign is_collection = false -%}
{%- if template.name == 'collection' and collection != blank -%}
  {%- assign is_collection = true -%}
{%- endif -%}

{%- assign general_faqs = shop.metafields.custom.general_store_faq -%}

<section class="faq-section page-width">
  {%- if section.settings.heading != blank -%}
    <h2 class="faq-section__title">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <div class="faq-groups">
    {%- comment -%} ✅ Collection FAQ varsa onları göster {%- endcomment -%}
    {%- if is_collection and collection.metafields.custom.faq_groups != blank -%}
      {%- for faq_group in collection.metafields.custom.faq_groups.value -%}
        <article class="faq-group">
          {%- if faq_group.title != blank and section.settings.show_group_titles -%}
            <h3 class="faq-group__title">{{ faq_group.title }}</h3>
          {%- endif -%}
          <div class="faq-accordion">
            {%- for item in faq_group.items.value -%}
              <details class="faq-item" {%- if section.settings.open_first and forloop.first -%}open{%- endif -%}>
                <summary class="faq-question">
                  <span>{{ item.question }}</span>
                  <span class="faq-icon">+</span>
                </summary>
                <div class="faq-answer rte">
                  {{ item.answer | metafield_tag }}
                </div>
              </details>
            {%- endfor -%}
          </div>
        </article>
      {%- endfor -%}
    
    {%- comment -%} ✅ Yoksa General FAQ göster {%- endcomment -%}
    {%- elsif general_faqs != blank -%}
      {%- for faq_group in general_faqs.value -%}
        <article class="faq-group">
          {%- if faq_group.title != blank and section.settings.show_group_titles -%}
            <h3 class="faq-group__title">{{ faq_group.title }}</h3>
          {%- endif -%}
          <div class="faq-accordion">
            {%- for item in faq_group.items.value -%}
              <details class="faq-item" {%- if section.settings.open_first and forloop.first -%}open{%- endif -%}>
                <summary class="faq-question">
                  <span>{{ item.question }}</span>
                  <span class="faq-icon">+</span>
                </summary>
                <div class="faq-answer rte">
                  {{ item.answer | metafield_tag }}
                </div>
              </details>
            {%- endfor -%}
          </div>
        </article>
      {%- endfor -%}
    {%- else -%}
      <div class="faq-empty"><p>No FAQ data found.</p></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "FAQ Section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "checkbox",
      "id": "show_group_titles",
      "label": "Show group titles",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open first item open by default",
      "default": true
    }
  ],
  "presets": [
    { "name": "FAQ Section" }
  ],
  "enabled_on": {
    "templates": ["index", "collection"]
  }
}
{% endschema %}
