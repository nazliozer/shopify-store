{% if section.settings.faq_metaobject %}
  {% assign faq_group = section.settings.faq_metaobject %}

  <div class="faq-section">
    <h2 class="faq-title">{{ faq_group.title }}</h2>

    <div class="faq-items">
      {% for item in faq_group.items.value %}
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            {{ item.question.value }}
          </button>
          <div class="faq-answer">
            {{ item.answer.value }}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
{% endif %}
