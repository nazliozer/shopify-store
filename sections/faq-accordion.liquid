{%- assign is_collection = false -%}
{%- if template.name == 'collection' and collection != blank -%}
  {%- assign is_collection = true -%}
{%- endif -%}
{%- assign groups = '' | split: '|' -%}

{%- comment -%} a) Section setting: "General Store FAQ" gibi global seçilen grup {%- endcomment -%}
{%- if section.settings.faq_group != blank -%}
  {%- assign groups = groups | concat: section.settings.faq_group | uniq -%}
{%- endif -%}

{%- comment -%} b) Koleksiyona bağlı gruplar (varsa) {%- endcomment -%}
{%- if is_collection and collection.metafields.custom.faq_groups.value != blank -%}
  {%- for g in collection.metafields.custom.faq_groups.value -%}
    {%- assign groups = groups | concat: g | uniq -%}
  {%- endfor -%}
{%- endif -%}

<section class="faq-section page-width">
  <h2 class="faq-section__title">
    {{ section.settings.heading | default: 'Frequently Asked Questions' }}
  </h2>

  {%- if section.settings.subtext != blank -%}
    <p class="faq-section__subtitle">{{ section.settings.subtext }}</p>
  {%- endif -%}

  <div class="faq-groups">
    {%- if groups != blank -%}
      {%- for group in groups -%}
        {%- comment -%} FAQ group metafield'ını al {%- endcomment -%}
        {%- assign faq_group_metafield = group | metafield_tag -%}
        {%- if faq_group_metafield != blank -%}
          {%- assign items = faq_group_metafield.items.value -%}
          {%- if items != blank -%}
            <article class="faq-group">
              {%- if faq_group_metafield.title != blank and section.settings.show_group_titles -%}
                <h3 class="faq-group__title">{{ faq_group_metafield.title }}</h3>
              {%- endif -%}

              <div class="faq-accordion">
                {%- assign limit = section.settings.limit_per_group | default: 50 -%}
                {%- for item in items limit: limit -%}
                  <details class="faq-item" {%- if section.settings.open_first and forloop.first -%}open{%- endif -%}>
                    <summary class="faq-question">
                      <span>{{ item.question }}</span>
                      <span class="faq-icon" aria-hidden="true">+</span>
                    </summary>
                    <div class="faq-answer rte">
                      {{ item.answer | metafield_tag }}
                    </div>
                  </details>
                {%- endfor -%}
              </div>
            </article>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    {%- else -%}
      <p>No FAQ data found.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "settings": [
    {
      "type": "metaobject",
      "id": "faq_group",
      "label": "Select FAQ group",
      "metaobject_type": "faq_group"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subheading / helper text"
    },
    {
      "type": "checkbox",
      "id": "show_group_titles",
      "label": "Show group titles",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open first item by default",
      "default": true
    },
    {
      "type": "range",
      "id": "limit_per_group",
      "label": "Limit per group",
      "min": 1,
      "max": 50,
      "step": 1,
      "default": 10
    }
  ],
  "presets": [
    { "name": "FAQ (General + Collection)" }
  ],
  "enabled_on": {
    "templates": ["index", "collection"]
  }
}
{% endschema %}
