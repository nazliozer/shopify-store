{%- assign is_collection = false -%}
{%- if template.name == 'collection' and collection != blank -%}
  {%- assign is_collection = true -%}
{%- endif -%}

<style>
.faq-section {
  padding: 4rem 0;
  background: #ffffff;
}

.faq-section__title {
  font-size: 2.5rem;
  font-weight: 300;
  text-align: center;
  margin-bottom: 1rem;
  color: #1a1a1a;
  position: relative;
  letter-spacing: -0.02em;
}

.faq-section__title::after {
  content: '';
  position: absolute;
  bottom: -12px;
  left: 50%;
  transform: translateX(-50%);
  width: 60px;
  height: 1px;
  background: #e0e0e0;
}

.faq-section__subtitle {
  text-align: center;
  font-size: 1.125rem;
  color: #666666;
  margin-bottom: 3rem;
  max-width: 600px;
  margin-left: auto;
  margin-right: auto;
  line-height: 1.6;
  font-weight: 300;
}

.faq-groups {
  max-width: 800px;
  margin: 0 auto;
}

.faq-group {
  margin-bottom: 2rem;
  background: #ffffff;
  border: 1px solid #f0f0f0;
  border-radius: 8px;
  overflow: hidden;
  transition: all 0.2s ease;
}

.faq-group:hover {
  border-color: #d0d0d0;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}

.faq-group__title {
  background: #fafafa;
  color: #333333;
  padding: 1.25rem 1.5rem;
  margin: 0;
  font-size: 1.125rem;
  font-weight: 500;
  text-align: left;
  border-bottom: 1px solid #f0f0f0;
  letter-spacing: -0.01em;
}

.faq-accordion {
  padding: 0;
}

.faq-item {
  border-bottom: 1px solid #f8f8f8;
  transition: all 0.2s ease;
}

.faq-item:last-child {
  border-bottom: none;
}

.faq-item:hover {
  background-color: #fafafa;
}

.faq-question {
  padding: 1.25rem 1.5rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-weight: 400;
  color: #333333;
  font-size: 1rem;
  line-height: 1.5;
  transition: all 0.2s ease;
  user-select: none;
}

.faq-question:hover {
  color: #1a1a1a;
  background-color: #fafafa;
}

.faq-question:focus {
  outline: none;
  background-color: #f5f5f5;
}

.faq-icon {
  font-size: 1.25rem;
  font-weight: 300;
  color: #999999;
  transition: all 0.2s ease;
  width: 20px;
  height: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f5f5f5;
}

details[open] .faq-icon {
  transform: rotate(45deg);
  background: #e8e8e8;
  color: #666666;
}

.faq-answer {
  padding: 0 1.5rem 1.25rem 1.5rem;
  color: #555555;
  line-height: 1.7;
  font-size: 0.95rem;
  animation: slideDown 0.2s ease-out;
  font-weight: 300;
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-5px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.faq-answer p {
  margin: 0 0 1rem 0;
}

.faq-answer p:last-child {
  margin-bottom: 0;
}

/* Responsive Design */
@media (max-width: 768px) {
  .faq-section {
    padding: 2rem 1rem;
  }
  
  .faq-section__title {
    font-size: 2rem;
  }
  
  .faq-group {
    margin-bottom: 1.5rem;
    border-radius: 6px;
  }
  
  .faq-group__title {
    padding: 1rem 1.25rem;
    font-size: 1rem;
  }
  
  .faq-question {
    padding: 1rem 1.25rem;
    font-size: 0.95rem;
  }
  
  .faq-answer {
    padding: 0 1.25rem 1rem 1.25rem;
  }
}

/* Empty State */
.faq-empty {
  text-align: center;
  padding: 3rem 2rem;
  color: #999999;
  background: #fafafa;
  border-radius: 8px;
  border: 1px solid #f0f0f0;
}

.faq-empty p {
  font-size: 1rem;
  margin: 0;
  font-weight: 300;
}
</style>

<section class="faq-section page-width">
  {%- if section.settings.heading != blank -%}
    <h2 class="faq-section__title">
      {{ section.settings.heading }}
    </h2>
  {%- endif -%}

  {%- if section.settings.subtext != blank -%}
    <p class="faq-section__subtitle">{{ section.settings.subtext }}</p>
  {%- endif -%}

  <div class="faq-groups">
    {%- comment -%} General Store FAQ from section settings {%- endcomment -%}
    {%- if section.settings.faq_group != blank -%}
      {%- assign faq_group = section.settings.faq_group -%}
      {%- if faq_group.items.value != blank -%}
        <article class="faq-group">
          {%- if faq_group.title != blank and section.settings.show_group_titles -%}
            <h3 class="faq-group__title">{{ faq_group.title }}</h3>
          {%- endif -%}

          <div class="faq-accordion">
            {%- assign limit = section.settings.limit_per_group | default: 50 -%}
            {%- for item in faq_group.items.value limit: limit -%}
              <details class="faq-item" {%- if section.settings.open_first and forloop.first -%}open{%- endif -%}>
                <summary class="faq-question">
                  <span>{{ item.question }}</span>
                  <span class="faq-icon" aria-hidden="true">+</span>
                </summary>
                <div class="faq-answer rte">
                  {{ item.answer | metafield_tag }}
                </div>
              </details>
            {%- endfor -%}
          </div>
        </article>
      {%- endif -%}
    {%- endif -%}

    {%- comment -%} Collection-specific FAQ groups (if any) {%- endcomment -%}
    {%- if is_collection and collection.metafields.custom.faq_groups.value != blank -%}
      {%- for faq_group in collection.metafields.custom.faq_groups.value -%}
        {%- if faq_group.items.value != blank -%}
          <article class="faq-group">
            {%- if faq_group.title != blank and section.settings.show_group_titles -%}
              <h3 class="faq-group__title">{{ faq_group.title }}</h3>
            {%- endif -%}

            <div class="faq-accordion">
              {%- assign limit = section.settings.limit_per_group | default: 50 -%}
              {%- for item in faq_group.items.value limit: limit -%}
                <details class="faq-item" {%- if section.settings.open_first and forloop.first -%}open{%- endif -%}>
                  <summary class="faq-question">
                    <span>{{ item.question }}</span>
                    <span class="faq-icon" aria-hidden="true">+</span>
                  </summary>
                  <div class="faq-answer rte">
                    {{ item.answer | metafield_tag }}
                  </div>
                </details>
              {%- endfor -%}
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}

    {%- comment -%} Show message if no FAQ data found {%- endcomment -%}
    {%- if section.settings.faq_group == blank -%}
      {%- if is_collection == false -%}
        <div class="faq-empty">
          <p>No FAQ data found. Please select a FAQ group in the section settings.</p>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "settings": [
    {
      "type": "metaobject",
      "id": "faq_group",
      "label": "Select FAQ group",
      "metaobject_type": "faq_group"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subheading / helper text"
    },
    {
      "type": "checkbox",
      "id": "show_group_titles",
      "label": "Show group titles",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open first item by default",
      "default": true
    },
    {
      "type": "range",
      "id": "limit_per_group",
      "label": "Limit per group",
      "min": 1,
      "max": 50,
      "step": 1,
      "default": 10
    }
  ],
  "presets": [
    { "name": "FAQ (General + Collection)" }
  ],
  "enabled_on": {
    "templates": ["index", "collection"]
  }
}
{% endschema %}
