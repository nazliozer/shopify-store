{% schema %}
{
  "name": "FAQ Section",
  "settings": [
    {
      "type": "metaobject",
      "id": "faq_metaobject",
      "label": "General FAQ Group (Homepage)",
      "metaobject_type": "faq_group"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 10,
      "label": "Limit per group"
    }
  ],
  "presets": [
    {
      "name": "FAQ Section"
    }
  ]
}
{% endschema %}

{% comment %} Check if we're on homepage or collection page {% endcomment %}
{% assign is_homepage = false %}
{% assign is_collection_page = false %}

{% if template.name == 'index' %}
  {% assign is_homepage = true %}
{% elsif template.name == 'collection' and collection != blank %}
  {% assign is_collection_page = true %}
{% endif %}

{% comment %} Get collection-specific FAQs {% endcomment %}
{% assign collection_faqs = blank %}
{% if is_collection_page %}
  {% assign collection_faqs = collection.metafields.custom.faq_groups.value %}
{% endif %}

{% comment %} Get general FAQs for homepage {% endcomment %}
{% assign general_faqs = blank %}
{% if is_homepage %}
  {% assign general_faqs = section.settings.faq_metaobject %}
{% endif %}

{% if collection_faqs != blank or general_faqs != blank %}
  <div class="faq-section page-width">
    {% if is_collection_page %}
      {% comment %} Show collection-specific FAQ title {% endcomment %}
      <h2 class="faq-title">{{ collection.title }} FAQ</h2>
      
      {% comment %} Display collection-specific FAQs {% endcomment %}
      {% for faq_group in collection_faqs %}
        {% if faq_group.items.value != blank %}
          <div class="faq-items">
            {% for item in faq_group.items.value limit: section.settings.limit %}
              <details class="faq-item">
                <summary class="faq-question">
                  <span>{{ item.question.value }}</span>
                  <span class="faq-icon" aria-hidden="true">+</span>
                </summary>
                <div class="faq-answer rte">
                  {{ item.answer | metafield_tag }}
                </div>
              </details>
            {% endfor %}
          </div>
        {% endif %}
      {% endfor %}
      
    {% elsif is_homepage and general_faqs != blank %}
      {% comment %} Show general FAQ title {% endcomment %}
      <h2 class="faq-title">{{ general_faqs.title }}</h2>
      
      {% comment %} Display general FAQs {% endcomment %}
      <div class="faq-items">
        {% for item in general_faqs.items.value limit: section.settings.limit %}
          <details class="faq-item">
            <summary class="faq-question">
              <span>{{ item.question.value }}</span>
              <span class="faq-icon" aria-hidden="true">+</span>
            </summary>
            <div class="faq-answer rte">
              {{ item.answer | metafield_tag }}
            </div>
          </details>
        {% endfor %}
      </div>
    {% endif %}
  </div>
{% endif %}

<style>
.faq-section {
  margin: 4rem 0;
  padding: 0 2rem;
}

.faq-title {
  font-size: 3rem;
  font-weight: 600;
  text-align: center;
  margin-bottom: 3.5rem;
  color: #2d3748;
  position: relative;
  letter-spacing: -0.03em;
}

.faq-title::after {
  content: '';
  position: absolute;
  bottom: -15px;
  left: 50%;
  transform: translateX(-50%);
  width: 80px;
  height: 3px;
  background: linear-gradient(90deg, #a0aec0, #cbd5e0);
  border-radius: 2px;
}

.faq-items {
  max-width: 800px;
  margin: 0 auto;
}

.faq-item {
  margin-bottom: 1.5rem;
  background: #ffffff;
  border-radius: 16px;
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.08), 0 2px 4px -1px rgba(0, 0, 0, 0.04);
  overflow: hidden;
  transition: all 0.3s ease;
  border: 1px solid #f0f0f0;
}

.faq-item:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 25px -3px rgba(0, 0, 0, 0.12), 0 4px 6px -2px rgba(0, 0, 0, 0.08);
  border-color: #e0e0e0;
}

.faq-question {
  padding: 1.75rem 2rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-weight: 500;
  color: #2d3748;
  font-size: 1.25rem;
  line-height: 1.4;
  transition: all 0.3s ease;
  user-select: none;
  background-color: #ffffff;
  border: none;
  width: 100%;
  text-align: left;
}

.faq-question:hover {
  color: #4a5568;
  background-color: #f7fafc;
}

.faq-question:focus {
  outline: none;
  background-color: #edf2f7;
}

details[open] .faq-question {
  background-color: #f7fafc;
  color: #4a5568;
  border: none;
}

.faq-icon {
  font-size: 1.75rem;
  font-weight: 300;
  color: #718096;
  transition: all 0.3s ease;
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #edf2f7;
  border: 2px solid #e2e8f0;
  flex-shrink: 0;
}

details[open] .faq-icon {
  transform: rotate(45deg);
  background: #a0aec0;
  color: #ffffff;
  border-color: #a0aec0;
}

.faq-answer {
  padding: 0 2rem 1.75rem 2rem;
  color: #4a5568;
  line-height: 1.7;
  font-size: 1.1rem;
  animation: slideDown 0.3s ease-out;
  font-weight: 400;
  background: #f7fafc;
  border: none;
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.faq-answer p {
  margin: 0 0 1rem 0;
}

.faq-answer p:last-child {
  margin-bottom: 0;
}

/* Responsive Design */
@media (max-width: 768px) {
  .faq-section {
    margin: 2rem 0;
    padding: 0 1rem;
  }
  
  .faq-title {
    font-size: 2.25rem;
    margin-bottom: 2.5rem;
  }
  
  .faq-item {
    margin-bottom: 1rem;
    border-radius: 12px;
  }
  
  .faq-question {
    padding: 1.5rem 1.5rem;
    font-size: 1.125rem;
  }
  
  .faq-answer {
    padding: 0 1.5rem 1.5rem 1.5rem;
  }
  
  .faq-icon {
    width: 32px;
    height: 32px;
    font-size: 1.5rem;
  }
}

/* Empty State */
.faq-empty {
  text-align: center;
  padding: 3rem 2rem;
  color: #718096;
  background: #ffffff;
  border-radius: 20px;
  box-shadow: 0 10px 25px -3px rgba(0, 0, 0, 0.08);
}

.faq-empty p {
  font-size: 1.125rem;
  margin: 0;
  font-weight: 400;
}
</style>
