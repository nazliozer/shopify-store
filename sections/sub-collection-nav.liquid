{%- comment -%}
  Sub-collection Slider (refined, Dawn-friendly)
  - Data: collection.metafields.custom.category_slider (List<Collection> OR List<Metaobject{collection}>)
{%- endcomment -%}

{% if template.name == 'collection' and collection %}
  {%- assign entries = collection.metafields.custom.category_slider.value -%}
  {%- if entries != blank -%}
    {%- assign cats = entries -%}
    {%- if entries.first and entries.first.object_type -%}
      {%- assign cats = entries | map: 'collection' -%}
    {%- endif -%}

    {%- if cats != blank -%}
    <section class="subcat-slider" aria-label="Sub-categories">
      <div class="subcat-slider__inner page-width">
        <div class="subcat-slider__header">
          <h2 class="subcat-slider__title">
            {{ section.settings.title | default: 'Featured categories' }}
          </h2>
        </div>

        <div class="subcat-slider__viewport">
          <button type="button" class="subcat-slider__arrow subcat-slider__arrow--prev" aria-label="Previous" disabled>‹</button>

          <div class="subcat-slider__track" role="tablist" tabindex="0">
            {%- for c in cats -%}
              {%- if c and c != blank -%}
              <a class="subcat-card{% if c.handle == collection.handle %} is-active{% endif %}" role="tab" href="{{ c.url }}">
                <div class="subcat-card__media">
                  {%- if c.image -%}
                    {{ c.image | image_url: width: 960 | image_tag: loading: 'lazy', alt: c.title }}
                  {%- else -%}
                    {{ 'collection-1' | placeholder_svg_tag }}
                  {%- endif -%}
                </div>
                <div class="subcat-card__body">
                  <span class="subcat-card__title">
                    {{ c.title }}
                    <span class="subcat-card__chev" aria-hidden="true">→</span>
                  </span>
                </div>
              </a>
              {%- endif -%}
            {%- endfor -%}
          </div>

          <button type="button" class="subcat-slider__arrow subcat-slider__arrow--next" aria-label="Next">›</button>

          <div class="subcat-slider__fade subcat-slider__fade--left" aria-hidden="true"></div>
          <div class="subcat-slider__fade subcat-slider__fade--right" aria-hidden="true"></div>
        </div>
      </div>
    </section>
    {%- endif -%}
  {%- endif -%}
{% endif %}

// ... existing code ...

{% javascript %}
document.addEventListener('DOMContentLoaded', function() {
  // Tüm subcat-slider'ları bul
  const sliders = document.querySelectorAll('.subcat-slider');
  
  sliders.forEach(function(slider) {
    const track = slider.querySelector('.subcat-slider__track');
    const prev = slider.querySelector('.subcat-slider__arrow--prev');
    const next = slider.querySelector('.subcat-slider__arrow--next');
    
    if (!track || !prev || !next) return;

    const step = () => {
      const card = track.querySelector('.subcat-card');
      if (card) {
        const cardW = card.getBoundingClientRect().width;
        const styles = getComputedStyle(track);
        const gap = parseFloat(styles.gap || styles.columnGap || 16);
        return Math.max(200, Math.round(cardW + gap));
      }
      return Math.round(track.clientWidth * 0.85);
    };

    const update = () => {
      const sl = Math.round(track.scrollLeft);
      const max = track.scrollWidth - track.clientWidth;
      prev.disabled = sl <= 1;
      next.disabled = sl >= (max - 1);
    };

    const scrollByStep = (dir = 1) => {
      track.scrollBy({ left: dir * step(), behavior: 'smooth' });
    };

    // Event listeners ekle
    prev.addEventListener('click', () => scrollByStep(-1));
    next.addEventListener('click', () => scrollByStep(1));
    track.addEventListener('scroll', update, { passive: true });
    
    // Klavye desteği
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { 
        e.preventDefault(); 
        scrollByStep(-1); 
      }
      if (e.key === 'ArrowRight') { 
        e.preventDefault(); 
        scrollByStep(1); 
      }
    });

    // Resize event listener
    const resizeObserver = new ResizeObserver(update);
    resizeObserver.observe(track);

    // İlk güncelleme
    update();
  });
});
{% endjavascript %}