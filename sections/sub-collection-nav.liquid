{%- comment -%}
  Sub-collection Slider (polished)
  - Data: collection.metafields.custom.category_slider (List<Collection> OR List<Metaobject{collection}>)
  - Shows only on collection templates.
{%- endcomment -%}

{% if template.name == 'collection' and collection %}
  {%- assign entries = collection.metafields.custom.category_slider.value -%}
  {%- if entries != blank -%}
    {%- comment %}
      Normalize to an array of Collections => cats
      If it's metaobjects (has object_type), map to their `collection` field.
    {%- endcomment -%}
    {%- assign cats = entries -%}
    {%- if entries.first and entries.first.object_type -%}
      {%- assign cats = entries | map: 'collection' -%}
    {%- endif -%}

    {%- if cats != blank -%}
    <section class="subcat-slider" aria-label="Sub-categories">
      <div class="subcat-slider__inner page-width">
        <div class="subcat-slider__header">
          <h2 class="subcat-slider__title">
            {{ section.settings.title | default: 'Featured categories' }}
          </h2>
        </div>

        <div class="subcat-slider__viewport">
          <button class="subcat-slider__arrow subcat-slider__arrow--prev" aria-label="Previous" disabled>‹</button>

          <div class="subcat-slider__track" role="tablist" tabindex="0">
            {%- for c in cats -%}
              {%- if c and c != blank -%}
              <a class="subcat-card{% if c.handle == collection.handle %} is-active{% endif %}" role="tab" href="{{ c.url }}">
                <div class="subcat-card__media">
                  {%- if c.image -%}
                    {{ c.image | image_url: width: 640 | image_tag: loading: 'lazy', alt: c.title }}
                  {%- else -%}
                    {{ 'collection-1' | placeholder_svg_tag }}
                  {%- endif -%}
                </div>
                <div class="subcat-card__body">
                  <span class="subcat-card__title">{{ c.title }}</span>
                </div>
              </a>
              {%- endif -%}
            {%- endfor -%}
          </div>

          <button class="subcat-slider__arrow subcat-slider__arrow--next" aria-label="Next">›</button>

          <div class="subcat-slider__fade subcat-slider__fade--left" aria-hidden="true"></div>
          <div class="subcat-slider__fade subcat-slider__fade--right" aria-hidden="true"></div>
        </div>
      </div>
    </section>
    {%- endif -%}
  {%- endif -%}
{% endif %}

{% schema %}
{
  "name": "Sub-collection slider",
  "settings": [
    { "type": "inline_richtext", "id": "title", "label": "Heading", "default": "Featured categories" }
  ],
  "presets": [{ "name": "Sub-collection slider" }],
  "enabled_on": { "templates": ["collection"] }
}
{% endschema %}

{% stylesheet %}
.subcat-slider{--gap:1rem;--card-w:280px;--radius:16px;--shadow:0 6px 18px rgba(0,0,0,.08);--ring:0 0 0 3px rgba(0,0,0,.08)}
.subcat-slider__header{display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem}
.subcat-slider__title{margin:0;font-weight:700}

.subcat-slider__viewport{position:relative}
.subcat-slider__track{
  display:flex;gap:var(--gap);
  overflow-x:auto;scroll-behavior:smooth;scroll-snap-type:x mandatory;
  padding: .25rem 3.5rem; /* space for arrows */
}
.subcat-card{
  flex:0 0 auto;width:var(--card-w);scroll-snap-align:start;
  border:1px solid #eee;border-radius:var(--radius);background:#fff;text-decoration:none;color:inherit;
  box-shadow:var(--shadow);transition:transform .18s ease, box-shadow .18s ease, border-color .18s ease;
}
.subcat-card:is(:hover,:focus-visible){transform:translateY(-2px);box-shadow:0 10px 24px rgba(0,0,0,.12);border-color:#e6e6e6;outline:none}
.subcat-card.is-active{box-shadow:var(--ring)}
.subcat-card__media{position:relative;overflow:hidden;border-top-left-radius:var(--radius);border-top-right-radius:var(--radius)}
/* 4:3 hero image; you can switch to 1:1 by changing padding-top to 100% */
.subcat-card__media::before{content:"";display:block;padding-top:75%}
.subcat-card__media img,
.subcat-card__media svg{
  position:absolute;inset:0;width:100%;height:100%;object-fit:cover
}
.subcat-card__body{padding:.9rem 1rem}
.subcat-card__title{font-weight:700;font-size:1rem;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}

.subcat-slider__arrow{
  position:absolute;top:50%;transform:translateY(-50%);
  width:40px;height:40px;border-radius:999px;border:1px solid #e6e6e6;background:#fff;
  box-shadow:0 4px 12px rgba(0,0,0,.08);display:grid;place-items:center;cursor:pointer;z-index:2
}
.subcat-slider__arrow--prev{left:.5rem}
.subcat-slider__arrow--next{right:.5rem}
.subcat-slider__arrow[disabled]{opacity:.35;cursor:not-allowed}

.subcat-slider__fade{pointer-events:none;position:absolute;top:0;height:100%;width:48px;z-index:1}
.subcat-slider__fade--left{left:0;background:linear-gradient(90deg,rgba(255,255,255,1),rgba(255,255,255,0))}
.subcat-slider__fade--right{right:0;background:linear-gradient(-90deg,rgba(255,255,255,1),rgba(255,255,255,0))}

@media (max-width: 900px){
  .subcat-slider{--card-w:220px}
}
@media (max-width: 640px){
  .subcat-slider{--card-w:180px;--gap:.75rem}
  .subcat-slider__track{padding:.25rem 2.75rem}
}
{% endstylesheet %}

{% javascript %}
(() => {
  const root = document.currentScript.closest('.subcat-slider');
  if(!root) return;
  const track = root.querySelector('.subcat-slider__track');
  const prev = root.querySelector('.subcat-slider__arrow--prev');
  const next = root.querySelector('.subcat-slider__arrow--next');

  const step = () => {
    const card = track.querySelector('.subcat-card');
    if(!card) return 300;
    const gap = parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap) || 16;
    return card.getBoundingClientRect().width + gap;
  };

  const update = () => {
    prev.disabled = track.scrollLeft <= 2;
    next.disabled = Math.ceil(track.scrollLeft + track.clientWidth) >= track.scrollWidth - 2;
  };

  prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
  next.addEventListener('click', () => track.scrollBy({ left:  step(), behavior: 'smooth' }));
  track.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', update);
  track.addEventListener('keydown', (e) => {
    if(e.key === 'ArrowLeft') prev.click();
    if(e.key === 'ArrowRight') next.click();
  });

  update();
})();
{% endjavascript %}
