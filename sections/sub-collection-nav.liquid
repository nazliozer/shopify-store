{%- comment -%}
  Enhanced Sub-collection Navigation with Better UX
  - Data: collection.metafields.custom.category_slider (List<Collection> OR List<Metaobject{collection}>)
{%- endcomment -%}

{%- comment -%}
  Determine which collection to use for sub-collections
{%- endcomment -%}
{%- assign target_collection = section.settings.featured_collection | default: collection -%}

{%- if target_collection -%}
  {%- comment -%} Debug: Check what we have {%- endcomment -%}
  {%- if request.design_mode -%}
    <div style="background: #f0f0f0; padding: 1rem; margin: 1rem 0; border-radius: 8px; font-size: 0.9rem;">
      <strong>Debug Info:</strong><br>
      Target Collection: {{ target_collection.title | json }}<br>
      Entries Count: {{ target_collection.metafields.custom.category_slider.value.size | json }}<br>
      First Entry: {{ target_collection.metafields.custom.category_slider.value.first | json }}<br>
      Cats Count: {{ cats.size | json }}<br>
      First Cat: {{ cats.first | json }}<br>
      First Cat Handle: {{ cats.first.handle | json }}<br>
      First Cat Collection: {{ cats.first.collection | json }}<br>
      Generated URL: /collections/{{ cats.first.handle | default: cats.first.collection | split: '/' | last }}<br>
    </div>
  {%- endif -%}
  
  {%- assign entries = target_collection.metafields.custom.category_slider.value -%}
  {%- if entries != blank -%}
    {%- assign cats = entries -%}
    {%- if entries.first and entries.first.object_type -%}
      {%- assign cats = entries | map: 'collection' -%}
    {%- endif -%}

    {%- if cats != blank -%}
    <section class="sub-collection-nav" aria-label="Sub-categories">
      <div class="sub-collection-nav__inner page-width">
        <div class="sub-collection-nav__header">
          <h2 class="sub-collection-nav__title">
            {{ section.settings.title | default: 'Explore Categories' }}
          </h2>
          {% if section.settings.subtitle != blank %}
            <p class="sub-collection-nav__subtitle">{{ section.settings.subtitle }}</p>
          {% endif %}
        </div>

        <div class="sub-collection-nav__viewport">
          <button type="button" class="sub-collection-nav__arrow sub-collection-nav__arrow--prev" aria-label="Previous categories" disabled>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>

          <div class="sub-collection-nav__track" role="tablist" tabindex="0">
            {%- for c in cats -%}
              {%- if c and c != blank -%}
              <a class="sub-collection-card{% if c.handle == collection.handle %} is-active{% endif %}" role="tab" href="/collections/{{ c.handle | default: c.collection | split: '/' | last }}">
                <div class="sub-collection-card__media">
                  {%- if c.image -%}
                    {{ c.image | image_url: width: 400, height: 300, crop: 'center' | image_tag: loading: 'lazy', alt: c.title, class: 'sub-collection-card__image' }}
                  {%- else -%}
                    {{ 'collection-1' | placeholder_svg_tag: class: 'sub-collection-card__placeholder' }}
                  {%- endif -%}
                  <div class="sub-collection-card__overlay">
                    <span class="sub-collection-card__view-more">View Collection</span>
                  </div>
                </div>
                <div class="sub-collection-card__body">
                  <h3 class="sub-collection-card__title">
                    {{ c.title }}
                  </h3>
                  {% if c.description != blank %}
                    <p class="sub-collection-card__description">{{ c.description | strip_html | truncate: 80 }}</p>
                  {% endif %}
                  {% if c.products_count != blank %}
                    <span class="sub-collection-card__count">{{ c.products_count }} products</span>
                  {% endif %}
                </div>
              </a>
              {%- endif -%}
            {%- endfor -%}
          </div>

          <button type="button" class="sub-collection-nav__arrow sub-collection-nav__arrow--next" aria-label="Next categories">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>

          <div class="sub-collection-nav__fade sub-collection-nav__fade--left" aria-hidden="true"></div>
          <div class="sub-collection-nav__fade sub-collection-nav__fade--right" aria-hidden="true"></div>
        </div>
      </div>
    </section>
    {%- endif -%}
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Sub-collection Navigation",
  "settings": [
    { 
      "type": "inline_richtext", 
      "id": "title", 
      "label": "Heading", 
      "default": "Explore Categories" 
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Discover our curated collections"
    },
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "Featured Collection",
      "info": "Select a collection to display its sub-collections. Leave empty to use current collection context."
    }
  ],
  "presets": [{ "name": "Sub-collection Navigation" }],
  "enabled_on": { "templates": ["collection", "index"] }
}
{% endschema %}

{% stylesheet %}
.sub-collection-nav {
  --gap: 1.5rem;
  --card-w: 320px;
  --card-h: 280px;
  --radius: 16px;
  --shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  --shadow-hover: 0 8px 30px rgba(0, 0, 0, 0.12);
  --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  margin: 3rem 0;
}

.sub-collection-nav__header {
  text-align: center;
  margin-bottom: 2.5rem;
}

.sub-collection-nav__title {
  margin: 0 0 0.75rem 0;
  font-weight: 700;
  font-size: clamp(1.75rem, 1.5rem + 1.5vw, 2.5rem);
  line-height: 1.2;
  color: var(--color-text);
  letter-spacing: -0.02em;
}

.sub-collection-nav__subtitle {
  margin: 0;
  font-size: clamp(1rem, 0.9rem + 0.5vw, 1.125rem);
  color: var(--color-text-light);
  line-height: 1.5;
  max-width: 600px;
  margin-left: auto;
  margin-right: auto;
}

.sub-collection-nav__viewport {
  position: relative;
  margin: 0 -1rem;
}

.sub-collection-nav__track {
  display: flex;
  gap: var(--gap);
  overflow-x: auto;
  scroll-behavior: smooth;
  scroll-snap-type: x mandatory;
  padding: 1rem 4rem;
  margin: 0 1rem;
}

.sub-collection-nav__track::-webkit-scrollbar {
  height: 6px;
}

.sub-collection-nav__track::-webkit-scrollbar-track {
  background: #f1f1f1;
  border-radius: 999px;
}

.sub-collection-nav__track::-webkit-scrollbar-thumb {
  background: #c1c1c1;
  border-radius: 999px;
  transition: background 0.2s ease;
}

.sub-collection-nav__track::-webkit-scrollbar-thumb:hover {
  background: #a8a8a8;
}

.sub-collection-card {
  flex: 0 0 auto;
  width: var(--card-w);
  height: var(--card-h);
  scroll-snap-align: start;
  border-radius: var(--radius);
  background: #fff;
  text-decoration: none;
  color: inherit;
  transition: var(--transition);
  box-shadow: var(--shadow);
  overflow: hidden;
  position: relative;
  display: flex;
  flex-direction: column;
}

.sub-collection-card:hover,
.sub-collection-card:focus-visible {
  transform: translateY(-4px);
  box-shadow: var(--shadow-hover);
  outline: none;
}

.sub-collection-card.is-active {
  box-shadow: 0 0 0 3px var(--color-accent), var(--shadow);
}

.sub-collection-card__media {
  position: relative;
  flex: 1;
  overflow: hidden;
  background: #f8f8f8;
}

.sub-collection-card__image,
.sub-collection-card__placeholder {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: var(--transition);
}

.sub-collection-card__placeholder {
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
}

.sub-collection-card__overlay {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: var(--transition);
}

.sub-collection-card:hover .sub-collection-card__overlay {
  opacity: 1;
}

.sub-collection-card__view-more {
  color: white;
  font-weight: 600;
  font-size: 0.875rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  padding: 0.75rem 1.5rem;
  border: 2px solid white;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10px);
}

.sub-collection-card__body {
  padding: 1.5rem;
  background: white;
  flex-shrink: 0;
}

.sub-collection-card__title {
  margin: 0 0 0.5rem 0;
  font-weight: 700;
  font-size: 1.125rem;
  line-height: 1.3;
  color: var(--color-text);
  letter-spacing: -0.01em;
}

.sub-collection-card__description {
  margin: 0 0 0.75rem 0;
  font-size: 0.875rem;
  line-height: 1.5;
  color: var(--color-text-light);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.sub-collection-card__count {
  display: inline-block;
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--color-accent);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  padding: 0.25rem 0.75rem;
  background: rgba(var(--color-accent-rgb), 0.1);
  border-radius: 999px;
}

.sub-collection-nav__arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 48px;
  height: 48px;
  border-radius: 50%;
  border: none;
  background: white;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
  display: grid;
  place-items: center;
  cursor: pointer;
  z-index: 2;
  transition: var(--transition);
  color: var(--color-text);
}

.sub-collection-nav__arrow:hover {
  background: var(--color-accent);
  color: white;
  transform: translateY(-50%) scale(1.05);
  box-shadow: 0 6px 25px rgba(0, 0, 0, 0.2);
}

.sub-collection-nav__arrow--prev {
  left: 0.5rem;
}

.sub-collection-nav__arrow--next {
  right: 0.5rem;
}

.sub-collection-nav__arrow[disabled] {
  opacity: 0.4;
  cursor: not-allowed;
  transform: translateY(-50%);
}

.sub-collection-nav__arrow[disabled]:hover {
  background: white;
  color: var(--color-text);
  transform: translateY(-50%);
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
}

.sub-collection-nav__fade {
  pointer-events: none;
  position: absolute;
  top: 0;
  height: 100%;
  width: 60px;
  z-index: 1;
}

.sub-collection-nav__fade--left {
  left: 0;
  background: linear-gradient(90deg, rgba(255, 255, 255, 1) 0%, rgba(255, 255, 255, 0.8) 50%, rgba(255, 255, 255, 0) 100%);
}

.sub-collection-nav__fade--right {
  right: 0;
  background: linear-gradient(-90deg, rgba(255, 255, 255, 1) 0%, rgba(255, 255, 255, 0.8) 50%, rgba(255, 255, 255, 0) 100%);
}

/* Responsive Design */
@media (max-width: 1200px) {
  .sub-collection-nav {
    --card-w: 280px;
    --card-h: 260px;
  }
}

@media (max-width: 900px) {
  .sub-collection-nav {
    --card-w: 260px;
    --card-h: 240px;
    --gap: 1.25rem;
  }
  
  .sub-collection-nav__track {
    padding: 1rem 3.5rem;
  }
}

@media (max-width: 640px) {
  .sub-collection-nav {
    --card-w: 220px;
    --card-h: 220px;
    --gap: 1rem;
    margin: 2rem 0;
  }
  
  .sub-collection-nav__header {
    margin-bottom: 2rem;
  }
  
  .sub-collection-nav__track {
    padding: 1rem 3rem;
    margin: 0 0.5rem;
  }
  
  .sub-collection-nav__arrow {
    width: 40px;
    height: 40px;
  }
  
  .sub-collection-card__body {
    padding: 1.25rem;
  }
  
  .sub-collection-card__title {
    font-size: 1rem;
  }
}

@media (max-width: 480px) {
  .sub-collection-nav {
    --card-w: 200px;
    --card-h: 200px;
  }
  
  .sub-collection-nav__track {
    padding: 1rem 2.5rem;
  }
}

/* Accessibility and Reduced Motion */
@media (prefers-reduced-motion: reduce) {
  .sub-collection-card,
  .sub-collection-card__overlay,
  .sub-collection-card__image,
  .sub-collection-nav__arrow {
    transition: none;
  }
  
  .sub-collection-nav__track {
    scroll-behavior: auto;
  }
}

/* Focus styles for better accessibility */
.sub-collection-card:focus-visible {
  outline: 2px solid var(--color-accent);
  outline-offset: 2px;
}

.sub-collection-nav__arrow:focus-visible {
  outline: 2px solid var(--color-accent);
  outline-offset: 2px;
}
{% endstylesheet %}

{% javascript %}
document.addEventListener('DOMContentLoaded', function() {
  const navigations = document.querySelectorAll('.sub-collection-nav');
  
  navigations.forEach(function(nav) {
    const track = nav.querySelector('.sub-collection-nav__track');
    const prev = nav.querySelector('.sub-collection-nav__arrow--prev');
    const next = nav.querySelector('.sub-collection-nav__arrow--next');
    
    if (!track || !prev || !next) return;

    const step = () => {
      const card = track.querySelector('.sub-collection-card');
      if (card) {
        const cardW = card.getBoundingClientRect().width;
        const styles = getComputedStyle(track);
        const gap = parseFloat(styles.gap || styles.columnGap || 24);
        return Math.max(200, Math.round(cardW + gap));
      }
      return Math.round(track.clientWidth * 0.8);
    };

    const update = () => {
      const sl = Math.round(track.scrollLeft);
      const max = track.scrollWidth - track.clientWidth;
      prev.disabled = sl <= 1;
      next.disabled = sl >= (max - 1);
    };

    const scrollByStep = (dir = 1) => {
      track.scrollBy({ left: dir * step(), behavior: 'smooth' });
    };

    // Event listeners
    prev.addEventListener('click', () => scrollByStep(-1));
    next.addEventListener('click', () => scrollByStep(1));
    track.addEventListener('scroll', update, { passive: true });
    
    // Keyboard navigation
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { 
        e.preventDefault(); 
        scrollByStep(-1); 
      }
      if (e.key === 'ArrowRight') { 
        e.preventDefault(); 
        scrollByStep(1); 
      }
    });

    // Touch/swipe support for mobile
    let startX = 0;
    let startY = 0;
    let isScrolling = false;

    track.addEventListener('touchstart', (e) => {
      startX = e.touches[0].clientX;
      startY = e.touches[0].clientY;
      isScrolling = false;
    }, { passive: true });

    track.addEventListener('touchmove', (e) => {
      if (!startX || !startY) return;
      
      const deltaX = startX - e.touches[0].clientX;
      const deltaY = startY - e.touches[0].clientY;
      
      if (Math.abs(deltaX) > Math.abs(deltaY)) {
        isScrolling = true;
      }
    }, { passive: true });

    track.addEventListener('touchend', (e) => {
      if (!startX || !startY || isScrolling) return;
      
      const deltaX = startX - e.changedTouches[0].clientX;
      const minSwipeDistance = 50;
      
      if (Math.abs(deltaX) > minSwipeDistance) {
        if (deltaX > 0) {
          scrollByStep(1);
        } else {
          scrollByStep(-1);
        }
      }
      
      startX = 0;
      startY = 0;
    });

    // Resize observer for better performance
    const resizeObserver = new ResizeObserver(update);
    resizeObserver.observe(track);

    // Initial update
    update();
  });
});
{% endjavascript %}
